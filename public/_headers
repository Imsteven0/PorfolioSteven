# Cabeceras HTTP de Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# JS y CSS generados por Vite llevan un hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Modelo 3D e imágenes no llevan hash: caché de una semana.
# Al cambiar el modelo, sube el ?v= de MODEL_URL (Character.tsx) y del preload (index.html).
/models/*
  Cache-Control: public, max-age=604800
/projects/*
  Cache-Control: public, max-age=604800
