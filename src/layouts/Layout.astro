---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '@fontsource-variable/onest';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Steven Araya - Desarrollador Web Full Stack | Portafolio de Proyectos y Experiencia" />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="desarrollador web, full stack, javascript, react, node.js, portfolio" />
		<meta name="author" content="Steven Araya González" />
		<link rel="icon" type="image/svg+xml" href="/devIcon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link href="/css/fontawesome.min.css" rel="stylesheet" />
		<link href="/css/brands.min.css" rel="stylesheet" />
		<link href="/css/solid.min.css" rel="stylesheet" />
	</head>
	<body class="relative">
		<!-- Efectos de fondo -->
		<div class="fixed inset-0 -z-10">
			<!-- Gradiente base -->
			<div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0f] via-[#14141f] to-[#0a0a0f]"></div>
			
			<!-- Efectos de luz -->
			<div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full filter blur-3xl opacity-20 animate-pulse"></div>
			<div class="absolute top-1/3 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full filter blur-3xl opacity-20 animate-pulse" style="animation-delay: 2s;"></div>
			<div class="absolute bottom-1/4 left-1/2 w-96 h-96 bg-pink-600/10 rounded-full filter blur-3xl opacity-20 animate-pulse" style="animation-delay: 4s;"></div>
			
			<!-- Patrón de puntos -->
			<div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 50px 50px;"></div>
		</div>

		<!-- Contenido -->
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
<style is:global>
	body {
		font-family: 'Onest Variable', system-ui, -apple-system, sans-serif;
		overflow-x: hidden;
	}
	
	/* Optimización de fuentes */
	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}
	
	p {
		line-height: 1.7;
		letter-spacing: 0.01em;
	}
</style>
