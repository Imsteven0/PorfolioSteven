---
import habilities from '../../public/json/habilities.json';

function hexToRgb(hex: string) {
	let r = parseInt(hex.slice(1, 3), 16);
	let g = parseInt(hex.slice(3, 5), 16);
	let b = parseInt(hex.slice(5, 7), 16);
	return [r, g, b];
}
---

<section class="py-20 scroll-m-20 w-full mx-auto px-4 container lg:max-w-6xl md:max-w-4xl" id="habilidades">
	<!-- Título de sección -->
	<div class="flex items-center gap-4 mb-12">
		<div class="flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 shadow-lg shadow-purple-500/50">
			<i class="fa-solid fa-code text-white text-xl"></i>
		</div>
		<h2 class="text-4xl md:text-5xl font-bold text-white">
			Habilidades & Tecnologías
		</h2>
	</div>

	<!-- Grid de habilidades -->
	<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
		{
			habilities.map((hab, index) => {
				let rgb = hexToRgb(hab.color);
				return (
					<div
						class="skill-card group relative glass-effect rounded-2xl p-6 flex flex-col items-center gap-4 hover:scale-110 transition-all duration-300 cursor-pointer"
						style={`--color: ${rgb.join(',')}; --colorFont: ${hab.color}; animation-delay: ${index * 0.05}s;`}
					>
						{/* Efecto de brillo al hover */}
						<div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" 
							 style={`background: radial-gradient(circle at center, rgba(${rgb.join(',')}, 0.2), transparent 70%);`}>
						</div>
						
						{/* Icono */}
						<div class="relative z-10 transform group-hover:scale-110 group-hover:-rotate-12 transition-transform duration-300">
							<img 
								class="size-14 md:size-16 drop-shadow-lg" 
								src={hab.imageSrc} 
								alt={hab.description}
							/>
						</div>
						
						{/* Nombre */}
						<p class="relative z-10 font-bold text-sm md:text-base text-white text-center transition-all duration-300"
						   style={`color: white;`}>
							{hab.description}
						</p>
						
						{/* Borde con gradiente al hover */}
						<div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 border-2 pointer-events-none"
							 style={`border-color: ${hab.color};`}>
						</div>
					</div>
				);
			})
		}
	</div>

	<!-- Nota adicional -->
	<div class="mt-12 text-center">
		<p class="text-gray-400 text-lg">
			<i class="fa-solid fa-sparkles text-amber-400 mr-2"></i>
			Y siempre aprendiendo nuevas tecnologías...
		</p>
	</div>
</section>

<style>
	.skill-card {
		opacity: 0;
		animation: fadeInScale 0.5s ease-out forwards;
	}
	
	@keyframes fadeInScale {
		from {
			opacity: 0;
			transform: scale(0.8);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
	
	.skill-card:hover {
		box-shadow: 
			0 0 30px rgba(var(--color), 0.3),
			0 0 60px rgba(var(--color), 0.2),
			inset 0 0 20px rgba(var(--color), 0.1);
	}
</style>
