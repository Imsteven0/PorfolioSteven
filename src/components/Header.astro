<header class="fixed top-0 left-0 right-0 z-50 px-4 py-6 transition-transform duration-300">
    <nav class="mx-auto max-w-fit">
        <ul class="flex flex-row gap-1 md:gap-2 glass-effect rounded-full px-4 md:px-6 py-3 shadow-2xl backdrop-blur-xl">
            <li>
                <a 
                    href="#experiencia" 
                    data-section="experiencia"
                    class="nav-link relative block px-3 md:px-4 py-2 text-sm md:text-base font-semibold text-gray-300 hover:text-white transition-all duration-300 rounded-full group"
                >
                    <span class="relative z-10 flex items-center gap-2">
                        <i class="fa-solid fa-briefcase text-xs"></i>
                        <span class="hidden sm:inline">Experiencia</span>
                    </span>
                    <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></div>
                </a>
            </li>
            <li>
                <a 
                    href="#habilidades" 
                    data-section="habilidades"
                    class="nav-link relative block px-3 md:px-4 py-2 text-sm md:text-base font-semibold text-gray-300 hover:text-white transition-all duration-300 rounded-full group"
                >
                    <span class="relative z-10 flex items-center gap-2">
                        <i class="fa-solid fa-code text-xs"></i>
                        <span class="hidden sm:inline">Habilidades</span>
                    </span>
                    <div class="absolute inset-0 bg-gradient-to-r from-purple-500 to-pink-600 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></div>
                </a>
            </li>
            <li>
                <a 
                    href="#sobre-mi" 
                    data-section="sobre-mi"
                    class="nav-link relative block px-3 md:px-4 py-2 text-sm md:text-base font-semibold text-gray-300 hover:text-white transition-all duration-300 rounded-full group"
                >
                    <span class="relative z-10 flex items-center gap-2">
                        <i class="fa-solid fa-user text-xs"></i>
                        <span class="hidden sm:inline">Sobre mí</span>
                    </span>
                    <div class="absolute inset-0 bg-gradient-to-r from-pink-500 to-rose-600 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></div>
                </a>
            </li>
            <li>
                <a 
                    href="mailto:stevenaraya005@gmail.com" 
                    class="nav-link relative block px-3 md:px-4 py-2 text-sm md:text-base font-semibold text-white transition-all duration-300 rounded-full group overflow-hidden"
                >
                    <span class="relative z-10 flex items-center gap-2">
                        <i class="fa-solid fa-envelope text-xs"></i>
                        <span class="hidden sm:inline">Contacto</span>
                    </span>
                    <div class="absolute inset-0 bg-gradient-to-r from-amber-500 to-orange-600 -z-10"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-amber-400 to-orange-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></div>
                </a>
            </li>
        </ul>
    </nav>
</header>

<script>
    // Scroll suave y animación del header
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.querySelector('header');
        const navLinks = document.querySelectorAll('.nav-link[data-section]');
        const sections = document.querySelectorAll('section[id]');
        let lastScroll = 0;

        // Función para actualizar el enlace activo
        function updateActiveLink() {
            let currentSection = '';
            
            sections.forEach((section) => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                const scrollPosition = window.scrollY + 200; // Offset para mejor detección

                if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
                    currentSection = section.getAttribute('id') || '';
                }
            });

            // Remover clase activa de todos los enlaces
            navLinks.forEach((link) => {
                const linkSection = link.getAttribute('data-section');
                const gradientDiv = link.querySelector('div:first-of-type');
                
                if (linkSection === currentSection) {
                    // Activar enlace actual
                    link.classList.add('active');
                    link.classList.remove('text-gray-300');
                    link.classList.add('text-white');
                    if (gradientDiv) {
                        gradientDiv.style.opacity = '1';
                    }
                } else {
                    // Desactivar otros enlaces
                    link.classList.remove('active');
                    link.classList.add('text-gray-300');
                    link.classList.remove('text-white');
                    if (gradientDiv && !link.matches(':hover')) {
                        gradientDiv.style.opacity = '0';
                    }
                }
            });
        }

        // Scroll handler
        window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;

            // Actualizar enlace activo
            updateActiveLink();

            // Ocultar/mostrar header al hacer scroll
            if (currentScroll > lastScroll && currentScroll > 500) {
                header?.classList.add('-translate-y-full');
            } else {
                header?.classList.remove('-translate-y-full');
            }

            lastScroll = currentScroll;
        });

        // Smooth scroll para los enlaces
        navLinks.forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href && href.startsWith('#')) {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        const offsetTop = target.offsetTop - 100; // Offset para el header fijo
                        window.scrollTo({
                            top: offsetTop,
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });

        // Inicializar estado activo
        updateActiveLink();
    });
</script>

<style>
    .nav-link.active {
        font-weight: 700;
    }
</style>