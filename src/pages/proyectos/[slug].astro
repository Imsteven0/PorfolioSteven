---
import Layout from '../../layouts/Layout.astro';
import projects from '../../../public/json/projects.json';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Steven Araya`}>
	<!-- Decorative Background Effects -->
	<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
		<div class="absolute top-20 -left-20 w-96 h-96 bg-cyan-500/20 rounded-full filter blur-[120px] animate-float"></div>
		<div class="absolute top-40 -right-20 w-96 h-96 bg-blue-500/20 rounded-full filter blur-[120px] animate-float" style="animation-delay: 2s;"></div>
		<div class="absolute bottom-20 left-1/3 w-96 h-96 bg-purple-500/20 rounded-full filter blur-[120px] animate-float" style="animation-delay: 4s;"></div>
	</div>

	<!-- Navigation Bar with glassmorphism -->
	<div class="sticky top-0 z-50 backdrop-blur-xl bg-[#0a0a0f]/80 border-b border-white/10">
		<div class="container mx-auto px-4 py-4 lg:max-w-7xl">
			<div class="flex items-center justify-between">
				<a 
					href="/#proyectos" 
					class="inline-flex items-center gap-2 text-gray-400 hover:text-cyan-400 transition-all group px-4 py-2 rounded-lg hover:bg-white/5"
				>
					<i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
					<span class="font-medium">Volver a proyectos</span>
				</a>
				
				<div class="flex items-center gap-3">
					{project.links.github && (
						<a
							href={project.links.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg transition-all text-gray-300 hover:text-white text-sm font-medium"
						>
							<i class="fa-brands fa-github"></i>
							<span class="hidden sm:inline">GitHub</span>
						</a>
					)}
					{project.links.demo && (
						<a
							href={project.links.demo}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 rounded-lg transition-all text-white text-sm font-semibold hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/50"
						>
							<i class="fa-solid fa-external-link-alt"></i>
							<span class="hidden sm:inline">Ver App</span>
						</a>
					)}
				</div>
			</div>
		</div>
	</div>

	<!-- Contenedor principal -->
	<div class="container mx-auto px-4 py-12 lg:max-w-7xl">
	<!-- Contenedor principal -->
	<div class="container mx-auto px-4 py-12 lg:max-w-7xl">
		<!-- Hero Section Premium -->
		<div class="relative mb-16">
			<!-- Badge destacado flotante -->
			{project.featured && (
				<div class="absolute -top-6 left-1/2 -translate-x-1/2 z-10 animate-fadeIn">
					<div class="inline-flex items-center gap-2 px-6 py-2 bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 rounded-full shadow-2xl shadow-amber-500/50 animate-glow">
						<i class="fa-solid fa-star text-white text-sm"></i>
						<span class="text-white text-sm font-bold tracking-wider">PROYECTO DESTACADO</span>
						<i class="fa-solid fa-star text-white text-sm"></i>
					</div>
				</div>
			)}

			<!-- Card principal con glassmorphism premium -->
			<div class="glass-effect rounded-3xl overflow-hidden border border-white/10 shadow-2xl relative group">
				<!-- Efecto de brillo superior -->
				<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400 to-transparent opacity-50"></div>
				
				<div class="grid lg:grid-cols-2 gap-0">
			

					<!-- Columna derecha: Información -->
					<div class="p-8 lg:p-12 flex flex-col justify-center relative">
						<!-- Título con gradiente animado -->
						<h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold mb-6 leading-tight">
							<span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 animate-gradient-text">
								{project.title}
							</span>
						</h1>
						
						<!-- Descripción destacada -->
						<p class="text-gray-300 text-lg lg:text-xl leading-relaxed mb-8">
							{project.description}
						</p>

						<!-- Métricas rápidas en cards premium -->
						{project.metrics && (
							<div class="grid grid-cols-2 gap-4 mb-8">
								<div class="group/metric relative overflow-hidden rounded-xl p-4 bg-gradient-to-br from-cyan-500/10 to-blue-600/10 border border-cyan-500/20 hover:border-cyan-400/50 transition-all duration-300">
									<div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover/metric:opacity-100 transition-opacity"></div>
									<div class="relative">
										<div class="flex items-center gap-2 mb-2">
											<div class="w-8 h-8 rounded-lg bg-cyan-500/20 flex items-center justify-center">
												<i class="fa-solid fa-users text-cyan-400 text-sm"></i>
											</div>
											<p class="text-gray-400 text-xs font-medium uppercase tracking-wider">{project.metrics.label}</p>
										</div>
										<p class="text-3xl font-bold text-white">{project.metrics.users}</p>
									</div>
								</div>
								
								<div class="group/metric relative overflow-hidden rounded-xl p-4 bg-gradient-to-br from-green-500/10 to-emerald-600/10 border border-green-500/20 hover:border-green-400/50 transition-all duration-300">
									<div class="absolute inset-0 bg-gradient-to-br from-green-500/5 to-transparent opacity-0 group-hover/metric:opacity-100 transition-opacity"></div>
									<div class="relative">
										<div class="flex items-center gap-2 mb-2">
											<div class="w-8 h-8 rounded-lg bg-green-500/20 flex items-center justify-center">
												<i class="fa-solid fa-bolt text-green-400 text-sm"></i>
											</div>
											<p class="text-gray-400 text-xs font-medium uppercase tracking-wider">Performance</p>
										</div>
										<p class="text-2xl font-bold text-white">{project.metrics.performance}</p>
									</div>
								</div>
							</div>
						)}

						<!-- Botones de acción premium -->
						<div class="flex flex-wrap gap-4">
							{project.links.github && (
								<a
									href={project.links.github}
									target="_blank"
									rel="noopener noreferrer"
									class="group/btn relative inline-flex items-center gap-3 px-6 py-3.5 bg-white/5 hover:bg-white/10 border border-white/20 hover:border-white/40 rounded-xl transition-all duration-300 text-white font-semibold overflow-hidden"
								>
									<div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/5 to-white/0 translate-x-[-100%] group-hover/btn:translate-x-[100%] transition-transform duration-700"></div>
									<i class="fa-brands fa-github text-xl relative z-10"></i>
									<span class="relative z-10">Ver código fuente</span>
								</a>
							)}
							{project.links.demo && (
								<a
									href={project.links.demo}
									target="_blank"
									rel="noopener noreferrer"
									class="group/btn relative inline-flex items-center gap-3 px-6 py-3.5 bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-600 rounded-xl transition-all duration-300 text-white font-semibold overflow-hidden hover:shadow-2xl hover:shadow-cyan-500/50 hover:scale-105"
								>
									<div class="absolute inset-0 bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-300"></div>
									<i class="fa-solid fa-rocket text-lg relative z-10 group-hover/btn:rotate-12 transition-transform"></i>
									<span class="relative z-10">Ver aplicación en vivo</span>
									<i class="fa-solid fa-arrow-right relative z-10 group-hover/btn:translate-x-1 transition-transform"></i>
								</a>
							)}
						</div>
					</div>

                    		<!-- Columna izquierda: Imagen con efectos premium -->
					<div class="relative overflow-hidden bg-gradient-to-br from-gray-900 to-black p-8 flex items-center justify-center">
						<!-- Patrón de fondo -->
						<div class="absolute inset-0 opacity-10">
							<div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
						</div>
						
						<!-- Imagen del proyecto con efectos -->
						<div class="relative w-full max-w-md">
							<!-- Glow effect detrás de la imagen -->
							<div class="absolute inset-0 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl filter blur-2xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
							
							<!-- Contenedor de imagen en formato móvil 800x950 -->
							<div 
								class="relative aspect-[8/9.5] rounded-2xl overflow-hidden border border-white/10 shadow-2xl transform group-hover:scale-105 transition-transform duration-700"
								transition:name={`project-image-${project.slug}`}
							>
								{/* Imagen del proyecto mockup mobile */}
								<img
									src={project.image}
									alt={project.title}
									class="w-full h-full object-cover"
								/>
								
								{/* Overlay con gradiente */}
								<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
								
								<!-- Badge de tipo de proyecto -->
								<div class="absolute top-4 right-4 px-3 py-1.5 bg-black/50 backdrop-blur-sm rounded-lg border border-white/20">
									<span class="text-xs font-semibold text-white">📱 Mobile App</span>
								</div>
							</div>

							<!-- Decoración geométrica -->
							<div class="absolute -bottom-4 -right-4 w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full filter blur-3xl opacity-40 group-hover:opacity-60 transition-opacity"></div>
							<div class="absolute -top-4 -left-4 w-32 h-32 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-full filter blur-3xl opacity-30 group-hover:opacity-50 transition-opacity"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Grid de contenido detallado -->
		<div class="grid lg:grid-cols-3 gap-8">
			<!-- Columna principal (2/3) - Contenido detallado -->
			<div class="lg:col-span-2 space-y-8">
				<!-- Descripción completa con diseño premium -->
				<section class="group/section relative">
					<div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-3xl opacity-0 group-hover/section:opacity-20 blur-xl transition-opacity duration-500"></div>
					<div class="relative glass-effect rounded-2xl p-8 border border-white/10 hover:border-cyan-500/30 transition-all duration-300">
						<div class="flex items-center gap-3 mb-6">
							<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/50">
								<i class="fa-solid fa-info-circle text-white text-xl"></i>
							</div>
							<h2 class="text-2xl lg:text-3xl font-bold text-white">Descripción Completa</h2>
						</div>
						<div class="relative">
							<div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-500 to-blue-600 rounded-full"></div>
							<p class="text-gray-300 leading-relaxed text-base lg:text-lg pl-6">
								{project.longDescription}
							</p>
						</div>
					</div>
				</section>

				<!-- Características principales con diseño de cards premium -->
				{project.features && project.features.length > 0 && (
					<section class="group/section relative">
						<div class="absolute -inset-1 bg-gradient-to-r from-purple-500 to-pink-600 rounded-3xl opacity-0 group-hover/section:opacity-20 blur-xl transition-opacity duration-500"></div>
						<div class="relative glass-effect rounded-2xl p-8 border border-white/10 hover:border-purple-500/30 transition-all duration-300">
							<div class="flex items-center gap-3 mb-6">
								<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center shadow-lg shadow-purple-500/50">
									<i class="fa-solid fa-star text-white text-xl"></i>
								</div>
								<h2 class="text-2xl lg:text-3xl font-bold text-white">Características Principales</h2>
							</div>
							<div class="grid gap-4">
								{project.features.map((feature, index) => (
									<div class="group/feature relative overflow-hidden rounded-xl p-4 bg-gradient-to-r from-white/5 to-white/[0.02] border border-white/10 hover:border-purple-400/50 hover:from-purple-500/10 hover:to-pink-500/5 transition-all duration-300">
										<div class="flex gap-4 items-start">
											<!-- Número decorativo -->
											<div class="flex-shrink-0 w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white text-sm font-bold shadow-lg shadow-purple-500/30 group-hover/feature:scale-110 transition-transform">
												{index + 1}
											</div>
											<p class="text-gray-300 leading-relaxed flex-1 pt-0.5">{feature}</p>
										</div>
										<!-- Efecto de brillo en hover -->
										<div class="absolute inset-0 bg-gradient-to-r from-purple-500/0 via-purple-500/10 to-purple-500/0 translate-x-[-100%] group-hover/feature:translate-x-[100%] transition-transform duration-700"></div>
									</div>
								))}
							</div>
						</div>
					</section>
				)}

				<!-- Logros destacados con diseño de grid premium -->
				{project.highlights && project.highlights.length > 0 && (
					<section class="group/section relative">
						<div class="absolute -inset-1 bg-gradient-to-r from-amber-500 to-orange-600 rounded-3xl opacity-0 group-hover/section:opacity-20 blur-xl transition-opacity duration-500"></div>
						<div class="relative glass-effect rounded-2xl p-8 border border-white/10 hover:border-amber-500/30 transition-all duration-300">
							<div class="flex items-center gap-3 mb-6">
								<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg shadow-amber-500/50">
									<i class="fa-solid fa-trophy text-white text-xl"></i>
								</div>
								<h2 class="text-2xl lg:text-3xl font-bold text-white">Logros Destacados</h2>
							</div>
							<div class="grid md:grid-cols-2 gap-3">
								{project.highlights.map((highlight) => (
									<div class="group/highlight relative overflow-hidden p-4 bg-gradient-to-br from-amber-500/5 to-orange-500/5 border border-amber-500/20 rounded-xl hover:border-amber-400/50 hover:from-amber-500/10 hover:to-orange-500/10 transition-all duration-300">
										<div class="flex gap-3 items-start">
											<div class="flex-shrink-0 w-6 h-6 rounded-lg bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mt-0.5 group-hover/highlight:rotate-12 transition-transform">
												<i class="fa-solid fa-check text-white text-xs"></i>
											</div>
											<p class="text-gray-300 text-sm leading-relaxed">{highlight}</p>
										</div>
									</div>
								))}
							</div>
						</div>
					</section>
				)}

				<!-- Desafíos técnicos con diseño de timeline -->
				{project.challenges && project.challenges.length > 0 && (
					<section class="group/section relative">
						<div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-3xl opacity-0 group-hover/section:opacity-20 blur-xl transition-opacity duration-500"></div>
						<div class="relative glass-effect rounded-2xl p-8 border border-white/10 hover:border-indigo-500/30 transition-all duration-300">
							<div class="flex items-center gap-3 mb-6">
								<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/50">
									<i class="fa-solid fa-puzzle-piece text-white text-xl"></i>
								</div>
								<h2 class="text-2xl lg:text-3xl font-bold text-white">Desafíos Técnicos Superados</h2>
							</div>
							<div class="space-y-4 relative">
								<!-- Línea vertical decorativa -->
								<div class="absolute left-5 top-6 bottom-6 w-0.5 bg-gradient-to-b from-indigo-500 via-purple-500 to-pink-500 hidden md:block"></div>
								
								{project.challenges.map((challenge, index) => (
									<div class="group/challenge relative pl-0 md:pl-14">
										<!-- Punto decorativo en la línea -->
										<div class="hidden md:flex absolute left-3 top-3 w-5 h-5 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 border-2 border-[#0a0a0f] group-hover/challenge:scale-125 transition-transform shadow-lg shadow-indigo-500/50"></div>
										
										<div class="relative overflow-hidden p-5 bg-gradient-to-r from-indigo-500/10 to-purple-500/5 border border-indigo-500/20 rounded-xl hover:border-indigo-400/50 hover:from-indigo-500/15 hover:to-purple-500/10 transition-all duration-300">
											<div class="flex gap-4 items-start">
												<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold shadow-lg shadow-indigo-500/30 group-hover/challenge:scale-110 transition-transform">
													{index + 1}
												</div>
												<p class="text-gray-300 leading-relaxed flex-1 pt-1.5">{challenge}</p>
											</div>
										</div>
									</div>
								))}
							</div>
						</div>
					</section>
				)}

				<!-- Impacto y resultados con diseño de cards con iconos -->
				{project.impact && project.impact.length > 0 && (
					<section class="group/section relative">
						<div class="absolute -inset-1 bg-gradient-to-r from-green-500 to-emerald-600 rounded-3xl opacity-0 group-hover/section:opacity-20 blur-xl transition-opacity duration-500"></div>
						<div class="relative glass-effect rounded-2xl p-8 border border-white/10 hover:border-green-500/30 transition-all duration-300">
							<div class="flex items-center gap-3 mb-6">
								<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-green-500/50">
									<i class="fa-solid fa-chart-line text-white text-xl"></i>
								</div>
								<h2 class="text-2xl lg:text-3xl font-bold text-white">Impacto y Resultados</h2>
							</div>
							<div class="grid gap-4">
								{project.impact.map((item) => (
									<div class="group/impact relative overflow-hidden p-5 bg-gradient-to-r from-green-500/10 to-emerald-500/5 border border-green-500/30 rounded-xl hover:border-green-400/60 hover:from-green-500/15 hover:to-emerald-500/10 transition-all duration-300 hover:scale-[1.02]">
										<div class="flex gap-4 items-start">
											<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center shadow-lg shadow-green-500/30 group-hover/impact:scale-110 group-hover/impact:rotate-6 transition-transform">
												<i class="fa-solid fa-arrow-trend-up text-white"></i>
											</div>
											<p class="text-gray-300 leading-relaxed pt-1.5">{item}</p>
										</div>
										<!-- Efecto de shimmer -->
										<div class="absolute inset-0 bg-gradient-to-r from-green-500/0 via-green-400/20 to-green-500/0 translate-x-[-100%] group-hover/impact:translate-x-[100%] transition-transform duration-1000"></div>
									</div>
								))}
							</div>
						</div>
					</section>
				)}
			</div>

			<!-- Sidebar (1/3) - Información complementaria sticky -->
			<div class="lg:col-span-1 space-y-6">
				<!-- Stack Tecnológico Premium -->
				<section class="glass-effect rounded-2xl p-6 border border-white/10 sticky top-24 space-y-6">
					<!-- Header con gradiente -->
					<div class="relative">
						<div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl opacity-20 blur-lg"></div>
						<div class="relative flex items-center gap-3 p-4 bg-gradient-to-r from-cyan-500/10 to-blue-600/10 border border-cyan-500/30 rounded-xl">
							<div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/50">
								<i class="fa-solid fa-code text-white"></i>
							</div>
							<h3 class="text-xl font-bold text-white">Stack Tecnológico</h3>
						</div>
					</div>

					<!-- Tags de tecnologías con diseño premium -->
					<div class="flex flex-wrap gap-2.5">
						{project.technologies.map((tech) => (
							<div class="group/tech relative">
								<div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-lg opacity-0 group-hover/tech:opacity-100 blur transition-opacity duration-300"></div>
								<span class="relative inline-block px-3.5 py-2 bg-gradient-to-br from-white/10 to-white/5 border border-white/20 hover:border-cyan-400/60 rounded-lg text-gray-200 text-sm font-semibold transition-all duration-300 cursor-default hover:scale-105 hover:-translate-y-0.5 shadow-lg">
									{tech}
								</span>
							</div>
						))}
					</div>

					<!-- Divider elegante -->
					<div class="relative h-px">
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
					</div>

					<!-- Métricas detalladas con iconos y colores -->
					{project.metrics && (
						<div class="space-y-4">
							<h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider flex items-center gap-2">
								<i class="fa-solid fa-chart-simple text-cyan-400"></i>
								Métricas Clave
							</h4>
							
							<div class="space-y-3">
								<!-- Métrica de usuarios -->
								<div class="group/metric relative overflow-hidden p-4 bg-gradient-to-br from-cyan-500/10 to-blue-600/10 border border-cyan-500/30 rounded-xl hover:border-cyan-400/60 transition-all duration-300">
									<div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-cyan-400/20 to-transparent rounded-full filter blur-2xl"></div>
									<div class="relative flex items-start justify-between">
										<div class="flex-1">
											<div class="flex items-center gap-2 mb-1">
												<div class="w-8 h-8 rounded-lg bg-cyan-500/20 flex items-center justify-center">
													<i class="fa-solid fa-users text-cyan-400 text-sm"></i>
												</div>
												<p class="text-gray-400 text-xs font-semibold uppercase tracking-wide">{project.metrics.label}</p>
											</div>
											<p class="text-3xl font-bold text-white mt-2 group-hover/metric:scale-105 transition-transform origin-left">
												{project.metrics.users}
											</p>
										</div>
